{
  "name": "aha-codex",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "npm run build:agent && vite build",
    "web:dev": "vite --host 127.0.0.1 --port 5173",
    "app:build": "tauri build",
    "build:agent": "node tools/build-skin-agent.mjs",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node installer/cli.mjs doctor",
    "install-launcher": "node installer/cli.mjs install-launcher",
    "skin:status": "node installer/cli.mjs status",
    "skin:pause": "node installer/cli.mjs pause",
    "skin:apply": "node installer/cli.mjs apply",
    "skin:check": "node installer/cli.mjs check-update",
    "skin:update": "node installer/cli.mjs update",
    "skin:sync": "node installer/cli.mjs sync-themes",
    "themes:build": "node tools/build-themes.mjs",
    "themes:predict": "python3 tools/build-image-themes.py",
    "themes:sync-github": "node tools/sync-github-image-themes.mjs",
    "themes:sync": "npm run themes:sync-github",
    "release:check": "npm run themes:predict && npm test && cargo test --manifest-path src-tauri/Cargo.toml && npm run build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  }
}
